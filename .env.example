# ====================================================================
# LiveShield BioSecurity Operations Platform - Environment Template
# ====================================================================

# Application Server
PORT=8081

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/liveshield
DATABASE_USERNAME=liveshield
DATABASE_PASSWORD=your_database_password_here

# Email Notification Service (Gmail OAuth / SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
ADMIN_EMAILS=admin@liveshield.io,security@liveshield.io

# Twilio WhatsApp Dispatch Service
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
LIVESHIELD_ADMIN_WHATSAPP_NUMBERS=whatsapp:+919876543210
